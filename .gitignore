# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# sqlite database
/prisma/dev.db
/prisma/dev.db-journal

# vercel
.vercel

# driver-generated screenshots (overwritten each run, not meant to be tracked)
/.claude/skills/*/screenshots/

# typescript
*.tsbuildinfo
next-env.d.ts
